#ddev-generated
# Install the Atlassian Teamwork Graph CLI (twg) in the web container.
# https://developer.atlassian.com/platform/teamwork-graph/twg-cli/getting-started/installation/
#
# Run the official installer unattended. It only skips its prompts when
# --yes, --skip-login and --skip-skills are all given. Logging in happens
# later with `ddev twg login`, and agent skills belong where the agent runs.
# /usr/local/bin is already on PATH, so the installer leaves shell profiles
# alone. The script is saved to a file first because `curl | sh` would hide
# a failed download.
#
# --yes also records consent to Atlassian's terms in $HOME/.config/twg, and
# twg leaves root-owned telemetry directories in $TMPDIR. Point both at a
# throwaway directory so the image ships no consent, config, cache or temp
# files. Users record their own consent with `ddev twg consent`.
RUN (command -v curl >/dev/null || (apt-get update \
      && apt-get install -y --no-install-recommends ca-certificates curl \
      && rm -rf /var/lib/apt/lists/*)) \
    && install_tmp=$(mktemp -d) \
    && curl -fsSL --retry 2 -o "$install_tmp/install" https://teamwork-graph.atlassian.com/cli/install \
    && HOME=$install_tmp TMPDIR=$install_tmp bash "$install_tmp/install" \
         --install-dir /usr/local/bin --yes --skip-login --skip-skills \
    && rm -rf "$install_tmp" \
    && twg -v
