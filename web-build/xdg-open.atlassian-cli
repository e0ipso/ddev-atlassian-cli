#!/bin/sh
#ddev-generated
# xdg-open shim for the Atlassian CLI inside the DDEV web container.
#
# The container has no browser or display, so a real xdg-open (or none at all)
# makes `acli auth login` fail. For Atlassian URLs this shim prints the OAuth
# URL, then waits for the user to paste the address the host browser ends up
# on after the permissions are accepted. That address points at acli's
# callback server (http://127.0.0.1:<port>/callback), which the host browser
# can't reach, so the shim replays it from inside the container.
#
# Any other URL goes to a real xdg-open when there is one. Without it, the
# shim prints the URL and reports success.
if [ "$#" -eq 0 ]; then
  echo "usage: xdg-open { file | URL }" >&2
  exit 1
fi

url=$1
ESC=$(printf '\033')

# True when the URL is https on atlassian.com, atlassian.net or a subdomain.
# The host is cut out before matching so that "atlassian.com.evil.example" and
# "evil.example/atlassian.com" don't pass.
is_atlassian_url() {
  case $1 in
    https://* | HTTPS://*) ;;
    *) return 1 ;;
  esac
  authority=${1#*://}
  authority=${authority%%[/?#]*}
  host=${authority##*@}
  host=$(printf '%s' "${host%%:*}" | tr 'A-Z' 'a-z')
  case $host in
    atlassian.com | *.atlassian.com | atlassian.net | *.atlassian.net) return 0 ;;
  esac
  return 1
}

# Replace this process with a real xdg-open, skipping the shim itself.
exec_real_xdg_open() {
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    candidate=$dir/xdg-open
    if [ -x "$candidate" ] && [ ! "$candidate" -ef "$0" ]; then
      IFS=$old_ifs
      exec "$candidate" "$@"
    fi
  done
  IFS=$old_ifs
}

# A failed redirection kills a non-interactive sh when it hits a special
# builtin, so probe the terminal from a subshell.
has_tty() {
  (: >/dev/tty) 2>/dev/null && (: </dev/tty) 2>/dev/null
}

# acli starts xdg-open with stdout and stderr pointing at /dev/null, so write
# straight to the terminal when there is one.
use_tty() {
  has_tty || return 1
  exec >/dev/tty
}

print_url() {
  use_tty
  echo
  echo "No browser available in this container. Open this URL on your host:"
  echo
  echo "  $url"
  echo
}

# Print host:port of the loopback redirect_uri in the OAuth URL. Fails for
# anything else, so the shim never replays a callback to an arbitrary host.
callback_redirect() {
  redirect=$(printf '%s' "$1" \
    | sed -n 's/.*[?&]redirect_uri=\([^&#]*\).*/\1/p' \
    | sed 's/%3[Aa]/:/g; s/%2[Ff]/\//g')
  case $redirect in
    http://127.0.0.1:[0-9]*/* | http://localhost:[0-9]*/*) ;;
    *) return 1 ;;
  esac
  hostport=${redirect#http://}
  hostport=${hostport%%/*}
  case ${hostport##*:} in
    '' | *[!0-9]*) return 1 ;;
  esac
  printf '%s' "$redirect"
}

# Redraw the spinner on the line above the prompt without moving the cursor.
# Echo is off while prompting, so the cursor never leaves the prompt line.
spin() {
  case $(($1 % 10)) in
    0) frame='⠋' ;;
    1) frame='⠙' ;;
    2) frame='⠹' ;;
    3) frame='⠸' ;;
    4) frame='⠼' ;;
    5) frame='⠴' ;;
    6) frame='⠦' ;;
    7) frame='⠧' ;;
    8) frame='⠇' ;;
    *) frame='⠏' ;;
  esac
  printf '%s7%s[1A\r%s[K  %s Waiting for the pasted URL...%s8' \
    "$ESC" "$ESC" "$ESC" "$frame" "$ESC"
}

# Read one line from the terminal in the background and drop it in $reply.
start_reader() {
  rm -f "$reply" "$reply.part"
  (
    IFS= read -r line </dev/tty
    printf '%s' "$line" >"$reply.part" && mv "$reply.part" "$reply"
  ) &
  reader=$!
}

# True when a connection is waiting on the callback port, which means the host
# browser did reach acli. Needs ss, and is simply false without it.
callback_has_connection() {
  command -v ss >/dev/null 2>&1 || return 1
  ss -H -ltn "sport = :$port" 2>/dev/null | awk '$2 > 0 { found = 1 } END { exit !found }'
}

# acli draws its own "Authenticating..." spinner on the terminal and reads the
# same keyboard input. Pause it while the prompt is up so the prompt owns the
# terminal, and let it go again before replaying the callback.
pause_acli() {
  [ "$(ps -o comm= -p "$PPID" 2>/dev/null)" = acli ] || return 0
  kill -STOP "$PPID" 2>/dev/null && paused=1
}

resume_acli() {
  [ -n "$paused" ] && kill -CONT "$PPID" 2>/dev/null
  paused=
}

# acli turns on bracketed paste, so the terminal wraps a paste in ESC[200~ and
# ESC[201~. Drop those markers, other control characters and whitespace.
clean_paste() {
  printf '%s' "$1" | sed "s/${ESC}\[20[01]~//g" | tr -d '[:cntrl:][:space:]'
}

cleanup() {
  [ -n "$reader" ] && kill "$reader" 2>/dev/null
  resume_acli
  printf '%s[?25l' "$ESC"
  rm -f "$reply" "$reply.part"
  [ -n "$saved_stty" ] && stty "$saved_stty" </dev/tty 2>/dev/null
}

login_with_pasted_url() {
  redirect=$1
  port=${redirect#http://}
  port=${port%%/*}
  port=${port##*:}

  use_tty
  echo
  echo "No browser available in this container. Open this URL on your host:"
  echo
  echo "  $url"
  echo
  echo "Accept the Atlassian permissions. The browser then tries to open"
  echo "$redirect?..."
  echo "and fails, or shows a blank page. Copy that full address from the"
  echo "address bar and paste it below."
  echo

  reply=$(mktemp) || exit 1
  rm -f "$reply"
  reader=
  paused=
  saved_stty=$(stty -g </dev/tty 2>/dev/null)
  trap 'cleanup; exit 130' INT TERM HUP
  trap cleanup EXIT

  # acli leaves the terminal in raw mode. Switch to line input with echo off,
  # so the pasted code and state don't end up in the scrollback.
  stty icanon icrnl -echo </dev/tty 2>/dev/null

  pause_acli
  printf '%s[?25h' "$ESC"
  start_reader
  printf '\n  Paste the URL (input is hidden), then press Enter: '
  tick=0
  while [ ! -f "$reply" ]; do
    if ! kill -0 "$PPID" 2>/dev/null; then
      exit 0
    fi
    if callback_has_connection; then
      printf '%s[2K\r%s[1A%s[2K\r' "$ESC" "$ESC" "$ESC"
      echo "  The browser reached acli, so there is nothing to paste."
      exit 0
    fi
    # The reader ends without a reply when the user presses Enter on an
    # empty line. Start a fresh one.
    if ! kill -0 "$reader" 2>/dev/null && [ ! -f "$reply" ]; then
      start_reader
    fi
    spin "$tick"
    tick=$((tick + 1))
    sleep 0.1
  done

  pasted=$(clean_paste "$(cat "$reply")")
  printf '%s[2K\r%s[1A%s[2K\r' "$ESC" "$ESC" "$ESC"
  rm -f "$reply"
  reader=
  echo
  return 0
}

if ! is_atlassian_url "$url"; then
  exec_real_xdg_open "$@"
  print_url
  exit 0
fi

# The Atlassian flow needs a terminal to prompt on and a loopback callback to
# replay the pasted URL to. Without either, print the URL like any other.
redirect=$(callback_redirect "$url") || { print_url; exit 0; }
has_tty || { print_url; exit 0; }

login_with_pasted_url "$redirect"

while :; do
  case $pasted in
    *://*) ;;
    *) pasted=http://$pasted ;;
  esac
  case $pasted in
    "$redirect"\?*)
      resume_acli
      status=$(curl -g -s -o /dev/null --noproxy '*' --max-time 15 \
        -w '%{http_code}' "$pasted")
      if [ "$status" != "000" ]; then
        echo "  Sent to acli, finishing the login."
        exit 0
      fi
      echo "  Could not reach acli on the callback port. Is it still running?"
      pause_acli
      ;;
    *)
      echo "  That is not the callback address. It must start with"
      echo "  $redirect?"
      ;;
  esac
  printf '  Paste it again (input is hidden), then press Enter: '
  IFS= read -r line </dev/tty || exit 1
  echo
  pasted=$(clean_paste "$line")
done
